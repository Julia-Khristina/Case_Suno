# Provedor LLM
LLM_MODE=simulated
GROQ_API_KEY=
GROQ_GENERATION_MODEL_ID=
GROQ_JUDGE_MODEL_ID=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# O juiz precisa de um modelo diferente do gerador (seção 4.7)
GROQ_JUDGE_REASONING_EFFORT=
GROQ_JUDGE_TEMPERATURE=0
GROQ_GENERATION_TEMPERATURE=0.3
# Modelos gpt-oss raciocinam antes de responder: esforço baixo na geração/extração (low | medium | high)
GROQ_GENERATION_REASONING_EFFORT=low
# Teto de tokens de saída por chamada (0 = padrão do provedor)
GROQ_MAX_COMPLETION_TOKENS=0
# Teto de chamadas ao modelo por execução do pipeline (proteção contra gasto descontrolado)
GROQ_MAX_CALLS_PER_RUN=60
GROQ_ESTIMATED_OUTPUT_TOKENS=1200
# 429: o cliente espera o tempo pedido pelo Groq ("try again in Xs"), até este máximo, por até N tentativas
GROQ_MAX_RETRIES_429=6
GROQ_MAX_RATE_LIMIT_WAIT=65
# Limite de tokens de SAÍDA por minuto, se o modelo tiver (ex.: qwen/qwen3.8-27b: 1000). 0 = desligado
GROQ_OTPM=0

# Limites (preencher com os limites reais verificados no console)
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000

# Banco
DATABASE_URL=postgresql://suno:suno@localhost:5432/suno
POSTGRES_USER=suno
POSTGRES_PASSWORD=suno
POSTGRES_DB=suno

# Fuso
APP_TIMEZONE=America/Sao_Paulo

# Profundidade maxima de recursao do grafo
GRAPH_MAX_RECURSION_DEPTH=5

# Cache
CACHE_DIR=.cache/suno
# Texto original dos documentos admitidos (arquivo por hash, seção 5)
DOCUMENTS_DIR=data/documentos

# Interface
STREAMLIT_PORT=8501