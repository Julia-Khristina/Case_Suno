# Provedor LLM
LLM_MODE=simulated
GROQ_API_KEY=
GROQ_GENERATION_MODEL_ID=
GROQ_JUDGE_MODEL_ID=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Limites (preencher com os limites reais verificados no console)
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000

# Banco
DATABASE_URL=postgresql://suno:suno@localhost:5432/suno
POSTGRES_USER=suno
POSTGRES_PASSWORD=suno
POSTGRES_DB=suno

# Fuso
APP_TIMEZONE=America/Sao_Paulo

# Profundidade maxima de recursao do grafo
GRAPH_MAX_RECURSION_DEPTH=5

# Cache
CACHE_DIR=.cache/suno

# Interface
STREAMLIT_PORT=8501